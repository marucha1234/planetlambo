{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "planetlambo.com"
        }
      ],
      "destination": "https://www.planetlambo.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path+/index.html",
      "destination": "/:path+/",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/productora-ia/",
      "permanent": true
    },
    {
      "source": "/projects/:path(.*)",
      "destination": "/productora-ia/",
      "permanent": true
    },
    {
      "source": "/en/projects",
      "destination": "/en/ai-production-company/",
      "permanent": true
    },
    {
      "source": "/en/projects/:path(.*)",
      "destination": "/en/ai-production-company/",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/work/:path(.*)",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "/#studio",
      "permanent": true
    },
    {
      "source": "/studio/:path(.*)",
      "destination": "/#studio",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#capabilities",
      "permanent": true
    },
    {
      "source": "/services/:path(.*)",
      "destination": "/#capabilities",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/whatsnextia/",
      "destination": "https://whats-next-blue.vercel.app/whatsnextia/"
    },
    {
      "source": "/whatsnextia/:path*/",
      "destination": "https://whats-next-blue.vercel.app/whatsnextia/:path*/"
    },
    {
      "source": "/whatsnextia/:path*",
      "destination": "https://whats-next-blue.vercel.app/whatsnextia/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.md)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/((?!assets/|css/|js/).*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
