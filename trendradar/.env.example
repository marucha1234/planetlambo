# --- Supabase -----------------------------------------------------------
# URL del proyecto (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Service role key (Settings → API → service_role). SOLO server-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron ---------------------------------------------------------------
# Secreto para proteger /api/cron/ingest. Vercel lo manda automáticamente
# como "Authorization: Bearer <valor>" en los crons si se define en el proyecto.
CRON_SECRET=

# --- Anthropic (Fase 3: capa de insight) --------------------------------
ANTHROPIC_API_KEY=

# --- TikTok Creative Center (opcionales) --------------------------------
# Los listados públicos suelen responder sin firma. Si TikTok empieza a
# devolver code != 0, copiar estos headers desde DevTools en una sesión
# del Creative Center (request a creative_radar_api) y setearlos acá.
TIKTOK_CC_USER_SIGN=
TIKTOK_CC_TIMESTAMP=
TIKTOK_CC_WEB_ID=
